{
  "name": "@sbordeyne/backstage-plugin-secure-share",
  "version": "0.2.0",
  "description": "Backstage frontend plugin for short-lived, end-to-end encrypted sharing of credentials, text and files between users and groups.",
  "license": "Apache-2.0",
  "homepage": "https://sbordeyne.github.io/backstage-plugins/plugins/secure-share/",
  "repository": {
    "url": "https://github.com/sbordeyne/backstage-plugins",
    "directory": "plugins/secure-share"
  },
  "bugs": "https://github.com/sbordeyne/backstage-plugins/issues",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "secrets",
    "encryption",
    "sharing",
    "frontend-plugin"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "secure-share",
    "pluginPackages": [
      "@sbordeyne/backstage-plugin-secure-share",
      "@sbordeyne/backstage-plugin-secure-share-backend"
    ]
  },
  "sideEffects": false,
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/catalog-model": "backstage:^",
    "@backstage/core-components": "backstage:^",
    "@backstage/core-plugin-api": "backstage:^",
    "@backstage/errors": "backstage:^",
    "@backstage/frontend-plugin-api": "backstage:^",
    "@backstage/plugin-catalog-react": "backstage:^",
    "@backstage/plugin-home-react": "backstage:^",
    "@material-ui/core": "^4.9.13",
    "@material-ui/icons": "^4.9.1",
    "@material-ui/lab": "^4.0.0-alpha.61",
    "@sbordeyne/secure-share-common": "workspace:^",
    "react-use": "^17.2.4"
  },
  "peerDependencies": {
    "react": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.0.0"
  },
  "devDependencies": {
    "@backstage/cli": "backstage:^",
    "@backstage/frontend-defaults": "backstage:^",
    "@backstage/frontend-test-utils": "backstage:^",
    "@backstage/test-utils": "backstage:^",
    "@testing-library/dom": "^9.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^18",
    "fake-indexeddb": "^6.0.0",
    "msw": "^1.0.0",
    "react": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.0.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.tsx",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "alpha": [
        "src/alpha.tsx"
      ],
      "package.json": [
        "package.json"
      ]
    }
  }
}
