{
  "name": "@sbordeyne/backstage-plugin-integrated-repositories",
  "version": "0.2.0",
  "description": "Backstage frontend plugin tracking how much of a GitHub organization the catalog covers, and turning the gap into a worklist.",
  "license": "Apache-2.0",
  "homepage": "https://sbordeyne.github.io/backstage-plugins/plugins/integrated-repositories/",
  "repository": {
    "url": "https://github.com/sbordeyne/backstage-plugins",
    "directory": "plugins/integrated-repositories"
  },
  "bugs": "https://github.com/sbordeyne/backstage-plugins/issues",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "catalog",
    "github",
    "coverage",
    "frontend-plugin"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "integrated-repositories",
    "pluginPackages": [
      "@sbordeyne/backstage-plugin-integrated-repositories"
    ]
  },
  "configSchema": "config.d.ts",
  "sideEffects": false,
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/catalog-model": "backstage:^",
    "@backstage/core-compat-api": "backstage:^",
    "@backstage/core-components": "backstage:^",
    "@backstage/core-plugin-api": "backstage:^",
    "@backstage/frontend-plugin-api": "backstage:^",
    "@backstage/integration": "backstage:^",
    "@backstage/integration-react": "backstage:^",
    "@backstage/plugin-catalog-react": "backstage:^",
    "@backstage/ui": "backstage:^",
    "@material-ui/icons": "^4.11.3",
    "react-use": "^17.2.4"
  },
  "peerDependencies": {
    "react": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.0.0"
  },
  "devDependencies": {
    "@backstage/cli": "backstage:^",
    "@backstage/dev-utils": "backstage:^",
    "@backstage/test-utils": "backstage:^",
    "@testing-library/dom": "^9.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^18",
    "react": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.0.0"
  },
  "files": [
    "dist",
    "config.d.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.tsx",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "alpha": [
        "src/alpha.tsx"
      ],
      "package.json": [
        "package.json"
      ]
    }
  }
}
