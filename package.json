{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20 || 22"
  },
  "packageManager": "yarn@4.4.1",
  "workspaces": {
    "packages": [
      "packages/*",
      "plugins/*"
    ]
  },
  "scripts": {
    "start": "backstage-cli repo start",
    "build:all": "backstage-cli repo build --all",
    "tsc": "tsc --skipLibCheck",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/master",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "new": "backstage-cli new --scope sbordeyne --no-private",
    "version:bump": "backstage-cli versions:bump",
    "release": "changeset version && yarn install --no-immutable",
    "release:publish": "yarn build:all && yarn publish:all && yarn changeset tag",
    "publish:all": "yarn workspaces foreach --all --topological --no-private npm publish --access public --tolerate-republish"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@backstage/cli": "backstage:^",
    "@backstage/cli-defaults": "backstage:^",
    "@changesets/cli": "^2.27.0",
    "@jest/environment-jsdom-abstract": "^30.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^27",
    "jest": "^30.2.0",
    "jest-canvas-mock": "^2.5.2",
    "jsdom": "^27.4.0",
    "prettier": "^2.3.2",
    "typescript": "~5.8.0"
  },
  "prettier": "@backstage/cli/config/prettier"
}
